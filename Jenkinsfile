pipeline{
  agent any
  stages{
    stage('Checkout'){
      steps{
        echo 'Code Checkout stage'
      }
    }
    stage('Build'){
      steps{
        echo 'Building the appliaction'
      }
    }
    stage('Test'){
      steps{
        echo 'Testing the appliaction'
      }
    }
    stage('Deploy'){
      steps{
        echo 'deploying the application'
      }
    }
  }
}
