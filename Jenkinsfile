pipeline {
    agent any 
    stages {
        stage('Checkout') {
            steps {
                echo 'code checkout'
            }
        }
        stage('Build') {
            steps {
                echo 'Building the test'
            }
        }
        stage('Test') {
            steps {
                echo 'Testing the application'
            }
        }
        stage('Deploy') {
            steps {
                echo 'Deploying the application'
            }
        }
    }
}
